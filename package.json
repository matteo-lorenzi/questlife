{
  "name": "questlife",
  "private": true,
  "version": "1.1.2",
  "description": "QuestLife - application de gestion d objectifs gamifiee",
  "author": "QuestLife",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "electron:dev": "node scripts/electron-dev.cjs",
    "electron:demo": "node scripts/electron-dev.cjs demo",
    "electron:empty": "node scripts/electron-dev.cjs empty",
    "electron:make-icon": "png-to-ico assets/icons/icon.png > assets/icons/icon.ico",
    "electron:build": "npm run build && npm run electron:make-icon && electron-builder --config electron-builder.json --win nsis",
    "electron:build:dir": "npm run build && npm run electron:make-icon && electron-builder --config electron-builder.json --win dir",
    "electron:build:signed": "node -e \"if(!process.env.CSC_LINK||!process.env.CSC_KEY_PASSWORD){console.error('Missing CSC_LINK or CSC_KEY_PASSWORD');process.exit(1)}\" && npm run electron:build"
  },
  "dependencies": {
    "@reactflow/core": "^11.11.3",
    "electron-updater": "^6.3.9",
    "nanoid": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "reactflow": "^11.11.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.1.2",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.11",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.3"
  }
}
